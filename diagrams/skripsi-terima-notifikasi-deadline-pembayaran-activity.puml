@startuml skripsi_terima_notifikasi_deadline_pembayaran_activity
title Activity Diagram — Terima Notifikasi Pengingat Deadline Pembayaran\nModul Notifikasi PWA

skinparam ActivityFontSize 12
skinparam TitleFontSize 14

|Sistem Cron|
start
:Menjalankan jadwal berkala\nmisal setiap 1 menit via cron-job.org;

:Rute GET /api/cron/payment-deadline-reminder\nheader Authorization Bearer CRON_SECRET;

|Server|
if (CRON_SECRET diatur dan token tidak valid?) then (ya)
  :Mengembalikan respons 401 Unauthorized;
  stop
else (tidak)
endif

:Membaca daftar menit pengingat\ndari PAYMENT_DEADLINE_REMINDER_MINUTES\ndefault 30 15 5;

repeat
  :Ambil satu ambang menit pengingat\nmisal 30 menit sebelum deadline;

  if (Menit melebihi PAYMENT_DEADLINE_MINUTES?) then (ya)
    :Lewati ambang ini;
  else (tidak)
    :Hitung rentang createdAt pesanan\nmasuk jendela pengingat tersebut;

    |BasisData|
    :Mencari pesanan NOT_PAID\nstatus bukan CANCELED\nbelum pernah dikirim field sentAt ambang ini;

    |Server|
    if (Tidak ada pesanan cocok?) then (ya)
      :Lanjut ambang menit berikutnya;
    else (ada)
      repeat
        :Menyusun URL detail transaksi pesanan;

        |BasisData|
        :Menghitung jumlah langganan push\nmilik userId pemilik pesanan;

        |Server|
        if (Tidak ada langganan push?) then (ya)
          :Catat pushFailedNoSubscription\nlanjut pesanan berikutnya;
        else (ada)
          |BasisData|
          :Mengambil data subscription terakhir\nendpoint p256dh auth;

          |Server|
          :Memanggil webPush.sendNotification\ndengan endpoint dan payload notifikasi;

          |Push Service|
          if (Endpoint langganan masih valid?) then (tidak, 410/404)
            |BasisData|
            :Menghapus subscription kadaluarsa;

            |Server|
            :Catat push gagal\nlanjut pesanan berikutnya;
          else (ya)
            :Meneruskan notifikasi ke perangkat pelanggan;

            |Server|
            |BasisData|
            :Menandai paymentDeadlineReminderSentAt\nuntuk ambang menit tersebut;

            |Server|
            :Menambah penghitung sent;
          endif
        endif
      repeat while (Masih ada pesanan dalam daftar?) is (ya)
      ->tidak;
    endif
  endif

repeat while (Masih ada ambang menit pengingat?) is (ya)
->tidak;

:Mengembalikan JSON sent matched pushFailed total;

|Service Worker PWA|
:event push diterima sw-push.js\n(dipicu oleh Push Service);
:showNotification judul dan isi\nrequireInteraction true;

|Pelanggan|
:Notifikasi pengingat deadline tampil\npada perangkat;

if (Mengetuk notifikasi?) then (ya)
  |Service Worker PWA|
  :notificationclick membuka halaman\ndetail transaksi pesanan;
  |Pelanggan|
  :Halaman transaksi ditampilkan\nuntuk melanjutkan pembayaran;
else (tidak)
endif

stop

@enduml
