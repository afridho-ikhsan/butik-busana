@startuml skripsi_aktifkan_notifikasi_push_sequence
title Sequence Diagram — Aktifkan Notifikasi Push\nModul Notifikasi PWA, PushNotificationPrompt

skinparam SequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 15
skinparam BoxPadding 15
skinparam DefaultFontSize 15
skinparam ArrowFontSize 13
skinparam ParticipantFontSize 15

actor Pelanggan as pengguna
participant "Aplikasi Butik Busana\n(Klien)" as klien
participant "Server Next.js\n(Aksi & API)" as server
database "BasisData\n(Prisma)" as db

pengguna -> klien: Menekan "Aktifkan notifikasi"
activate klien
klien -> pengguna: Modal konfirmasi Izinkan atau Tolak

alt Memilih Tolak atau menutup
  klien -> pengguna: Dialog ditutup
else Memilih Izinkan
  klien -> klien: Memeriksa VAPID Public Key

  alt VAPID tidak valid / Browser tidak mendukung Web Push
    klien -> pengguna: Menampilkan pesan kesalahan dukungan
  else VAPID valid & Didukung
    opt Izin notifikasi masih default
      klien -> pengguna: Prompt izin notifikasi browser
      pengguna -> klien: Memilih Izinkan (granted)
    end

    alt Izin ditolak (denied)
      klien -> pengguna: Menampilkan pesan kesalahan izin ditolak
    else Izin diberikan (granted)
      klien -> klien: Mendaftarkan Service Worker & Subscribe PushManager
      klien -> server: POST /api/push/subscribe (Kirim endpoint & keys)
      activate server

      server -> server: Memeriksa sesi pengguna aktif (getServerSession)
      server -> db: Hapus langganan lama & simpan PushSubscription baru
      activate db
      db --> server: Langganan disimpan
      deactivate db

      server --> klien: Respons sukses
      deactivate server

      klien -> pengguna: Menampilkan pesan notifikasi push aktif
    end
  end
end

deactivate klien

@enduml