@startuml skripsi_batalkan_pesanan_otomatis_sequence
title Sequence Diagram — Batalkan Pesanan Kedaluwarsa (Otomatis)\nModul Transaksi, GET /api/cron/cancel-expired-orders

skinparam SequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 15
skinparam BoxPadding 15
skinparam DefaultFontSize 15
skinparam ArrowFontSize 13
skinparam ParticipantFontSize 15

actor "Sistem Cron\ncron-job.org" as cron
participant "Server Next.js\n(Aksi & API)" as server
database "BasisData\n(Prisma)" as db

cron -> server: GET /api/cron/cancel-expired-orders\nAuthorization Bearer CRON_SECRET
activate server

alt Token tidak valid
  server --> cron: 401 Unauthorized
  deactivate server
else Token valid
  server -> server: deadline = now - PAYMENT_DEADLINE_MS

  server -> db: findMany NOT_PAID\nstatus bukan CANCELED\ncreatedAt lt deadline
  activate db
  db --> server: Daftar pesanan kedaluwarsa
  deactivate db

  alt Tidak ada pesanan
    server --> cron: JSON canceled 0
    deactivate server
  else Ada satu atau lebih pesanan
    loop Untuk setiap pesanan
      server -> db: update status CANCELED
      activate db
      db --> server: Konfirmasi
      deactivate db
    end

    server --> cron: JSON canceled
    deactivate server
  end
end

@enduml