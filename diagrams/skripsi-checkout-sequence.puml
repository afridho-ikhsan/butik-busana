@startuml skripsi_checkout_sequence
title Sequence Diagram — Proses Checkout & Pembayaran via Midtrans Snap

skinparam SequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 15
skinparam BoxPadding 15
skinparam DefaultFontSize 15
skinparam ArrowFontSize 13
skinparam ParticipantFontSize 15

actor Pelanggan as pengguna
participant "Aplikasi Butik Busana\n(Klien)" as klien
participant "Server Next.js\n(Aksi & API)" as server
database "BasisData\n(Prisma)" as db
participant "Midtrans\n(Gateway)" as midtrans

== Bagian 1: Pembuatan Pesanan ==

pengguna -> klien: Membuka keranjang & menekan Checkout
activate klien
klien -> pengguna: Menampilkan Formulir Pengiriman (Langkah 2)

pengguna -> klien: Mengisi data & menekan Lanjut Pembayaran
klien -> pengguna: Menampilkan dialog konfirmasi data

pengguna -> klien: Mengonfirmasi data pemesanan benar

klien -> klien: Memvalidasi formulir pengiriman
alt Validasi gagal
  klien -> pengguna: Menampilkan pesan kesalahan
else Validasi sukses
  klien -> server: createOrder(checkoutData)
  activate server

  server -> db: Mencatat pesanan baru (paymentStatus=NOT_PAID)
  activate db
  db --> server: Data pesanan tersimpan (orderId, orderNumber)
  deactivate db

  server --> klien: Konfirmasi pesanan dibuat (createdOrder)
  deactivate server

  klien -> klien: Beralih ke Langkah 3 (PaymentPage)
  klien -> pengguna: Menampilkan tombol "Bayar Virtual Account / QRIS"
end

== Bagian 2: Pembayaran via Midtrans Snap ==

pengguna -> klien: Menekan "Bayar Virtual Account / QRIS"

klien -> server: orderTokenizer(checkoutData)
activate server

server -> midtrans: createTransactionToken (Meminta token Snap)
activate midtrans
midtrans --> server: Token Snap pembayaran
deactivate midtrans

server --> klien: Token Snap
deactivate server

klien -> midtrans: snap.pay(token) (Membuka popup pembayaran Snap)
activate midtrans

pengguna -> midtrans: Menyelesaikan pembayaran (VA/QRIS)

par Callback Klien
  midtrans --> klien: Callback onSuccess()
  klien -> pengguna: Mengalihkan ke halaman daftar transaksi (/user/.../transactions)
  deactivate klien
else Webhook Server
  midtrans -> server: POST /api/midtrans-notification (Webhook)
  activate server

  alt status settlement / capture (Sukses)
    server -> db: Perbarui status pesanan (paymentStatus=PAID, status=APPROVED)
    activate db
    db --> server: Status diperbarui
    deactivate db
    server --> midtrans: HTTP 200 OK (Pembayaran Berhasil)
  else status deny / cancel / expire / failure (Gagal)
    server -> db: Perbarui status pesanan (status=CANCELED)
    activate db
    db --> server: Status diperbarui
    deactivate db
    server --> midtrans: HTTP 200 OK (Pembayaran Gagal/Batal)
  end
  deactivate server
  deactivate midtrans
end

@enduml