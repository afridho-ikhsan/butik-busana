@startuml skripsi_proses_pembayaran_sequence
title Sequence Diagram — Proses Pembayaran (VA, QRIS, E-Wallet)\nModul Transaksi, PaymentPage + Midtrans

skinparam SequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 15
skinparam BoxPadding 15
skinparam DefaultFontSize 15
skinparam ArrowFontSize 13
skinparam ParticipantFontSize 15

actor Pelanggan as pengguna
participant "Aplikasi Butik Busana\n(Klien)" as klien
participant "Server Next.js\n(Aksi & API)" as server
database "BasisData\n(Prisma)" as db
participant "Midtrans\n(Gateway)" as midtrans

pengguna -> klien: Membuka modal pembayaran pesanan
activate klien
klien -> server: getOrder(orderId)
activate server
server -> db: Mengambil data pesanan
activate db
db --> server: Order lineItems total
deactivate db
server --> klien: orderData
deactivate server
klien -> pengguna: Menampilkan opsi Pembayaran VA / QRIS / E-Wallet
deactivate klien

pengguna -> klien: Menekan Bayar Virtual Account / QRIS
activate klien

klien -> server: orderTokenizer(checkoutData)
activate server
server -> midtrans: createTransactionToken (Meminta token Snap)
activate midtrans
midtrans --> server: Token Snap pembayaran
deactivate midtrans
server --> klien: Token Snap
deactivate server

klien -> midtrans: snap.pay(token) (Membuka popup pembayaran Snap)
activate midtrans
pengguna -> midtrans: Menyelesaikan pembayaran (VA/QRIS)

par Callback klien
  midtrans --> klien: Callback onSuccess()
  klien -> pengguna: Mengalihkan ke halaman daftar transaksi (/user/.../transactions)
  deactivate klien
else Notifikasi server Midtrans (Webhook)
  midtrans -> server: POST /api/midtrans-notification (Webhook)
  activate server

  alt status settlement atau capture (sukses)
    server -> db: Perbarui status pesanan (paymentStatus=PAID, status=APPROVED)
    activate db
    db --> server: Status diperbarui
    deactivate db
    server --> midtrans: HTTP 200 OK (Pembayaran Berhasil)
  else status deny, cancel, expire, failure (gagal/batal)
    server -> db: Perbarui status pesanan (status=CANCELED)
    activate db
    db --> server: Status diperbarui
    deactivate db
    server --> midtrans: HTTP 200 OK (Pembayaran Gagal/Batal)
  end
  deactivate server
  deactivate midtrans
end

@enduml
