@startuml skripsi_ubah_data_produk_kategori_sequence
title Sequence Diagram — Ubah Data (Produk, Kategori) oleh Admin\nModul Admin, ProductForm & CollectionForm

skinparam SequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 15
skinparam BoxPadding 15
skinparam DefaultFontSize 15
skinparam ArrowFontSize 13
skinparam ParticipantFontSize 15

actor Admin as pengguna
participant "Aplikasi Butik Busana\n(Klien)" as klien
participant "Server Next.js\n(Aksi & API)" as server
database "BasisData\n(Prisma)" as db

pengguna -> klien: Mengubah nilai bidang data pada formulir (Produk/Kategori)
activate klien

pengguna -> klien: Menekan tombol "Simpan"

klien -> klien: Validasi input data (Zod resolver)

alt Validasi Klien Gagal
  klien -> pengguna: Menampilkan pesan kesalahan input
else Validasi Klien Sukses

  alt Mengubah Data Kategori
    klien -> server: PATCH /api/admin/collections/[id] { payload }
    activate server
    server -> server: Memvalidasi otorisasi peran (admin/owner)
    server -> db: prisma.collection.update()
    activate db
    db --> server: Data kategori terupdate
    deactivate db
    server --> klien: Respons sukses kategori terupdate (JSON)
  else Mengubah Data Produk
    klien -> server: PATCH /api/admin/products/[id] { payload }
    server -> server: Memvalidasi otorisasi peran (admin/owner)
    server -> server: Memvalidasi data input di sisi server
    server -> db: prisma.product.update()
    activate db
    db --> server: Data produk terupdate
    deactivate db
    server --> klien: Respons sukses produk terupdate (JSON)
    deactivate server
  end

  klien -> klien: Memperbarui tampilan katalog secara otomatis (router.push)
  klien -> pengguna: Menampilkan pesan sukses & dialihkan ke halaman daftar
end

deactivate klien

@enduml