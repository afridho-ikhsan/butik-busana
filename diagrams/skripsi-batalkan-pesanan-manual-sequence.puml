@startuml skripsi_batalkan_pesanan_manual_sequence
title Sequence Diagram — Batalkan Pesanan (Manual)\nModul Transaksi, CancelOrderButton

skinparam SequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 15
skinparam BoxPadding 15
skinparam DefaultFontSize 15
skinparam ArrowFontSize 13
skinparam ParticipantFontSize 15

actor Pelanggan as pengguna
participant "Aplikasi Butik Busana\n(Klien)" as klien
participant "Server Next.js\n(Aksi & API)" as server
database "BasisData\n(Prisma)" as db

pengguna -> klien: Membuka daftar transaksi & menekan "Batalkan"
activate klien
klien -> pengguna: Menampilkan konfirmasi pembatalan

alt Memilih Batal/Tutup
  klien -> pengguna: Dialog ditutup
else Memilih Konfirmasi Batalkan
  klien -> server: cancelOrder(orderId)
  activate server

  server -> db: findUnique order
  activate db
  db --> server: Data pesanan
  deactivate db

  alt Pesanan tidak ditemukan / paymentStatus bukan NOT_PAID
    server --> klien: success false
    klien -> pengguna: Tampilkan pesan galat pembatalan
  else Status sudah CANCELED
    server --> klien: success true
    klien -> pengguna: Tampilkan pesan berhasil & muat ulang daftar
  else Pesanan belum bayar dapat dibatalkan
    server -> db: update status CANCELED
    activate db
    db --> server: Konfirmasi update
    deactivate db

    server --> klien: success true
    deactivate server
    klien -> klien: router.refresh (Muat ulang data)
    klien -> pengguna: Status pesanan terupdate "Dibatalkan"
  end
end

deactivate klien

@enduml