@startuml skripsi_tambah_keranjang_sequence
title Sequence Diagram — Tambah Produk ke Keranjang\nPelanggan, halaman detail produk

skinparam SequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 15
skinparam BoxPadding 15
skinparam DefaultFontSize 15
skinparam ArrowFontSize 13
skinparam ParticipantFontSize 15

actor Pelanggan as pengguna
participant "Aplikasi Butik Busana\n(Klien)" as klien
participant "Server Next.js\n(Aksi & API)" as server
database "BasisData\n(Prisma)" as db

pengguna -> klien: Menetapkan kuantitas & menekan "Tambahkan ke keranjang"
activate klien

klien -> klien: Menyusun payload (produk, varian, kuantitas)

klien -> server: POST /api/cart (Kirim data produk)
activate server

server -> server: Memeriksa sesi pengguna aktif

alt Sesi tidak sah atau kosong
  server --> klien: Respons perlu login
  klien -> pengguna: Tampilkan pesan galat dari server
else Sesi sah
  server -> db: Membaca keranjang milik pengguna
  activate db
  db --> server: Daftar baris tersimpan
  deactivate db

  server -> server: Mencocokkan produk/varian dan menjumlahkan kuantitas

  server -> db: Menyimpan keranjang terbaru
  activate db
  db --> server: Tersimpan
  deactivate db

  server --> klien: Balasan keranjang terupdate
  deactivate server

  klien -> klien: Menyegarkan daftar keranjang & ikon penghitung
  klien -> pengguna: Tampilkan notifikasi produk masuk keranjang
end

deactivate klien

@enduml