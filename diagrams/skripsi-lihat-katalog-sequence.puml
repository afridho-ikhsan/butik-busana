@startuml skripsi_lihat_katalog_sequence
title Sequence Diagram — Lihat Katalog Produk\nPelanggan, halaman daftar produk

skinparam SequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 15
skinparam BoxPadding 15
skinparam DefaultFontSize 15
skinparam ArrowFontSize 13
skinparam ParticipantFontSize 15

actor Pelanggan as pengguna
participant "Aplikasi Butik Busana\n(Klien)" as klien
participant "Server Next.js\n(Aksi & API)" as server
database "BasisData\n(Prisma)" as db

pengguna -> klien: Membuka halaman daftar produk
activate klien

klien -> klien: Menyelaraskan parameter dari alamat\natau dari filter dan pencarian
klien -> klien: Membentuk permintaan GET /api/products terfilter

klien -> server: Meminta daftar produk (GET /api/products)
activate server

server -> db: Mengambil produk aktif\nsesuai harga koleksi urutan
activate db

opt Penyaringan menurut slug koleksi
  server -> db: Mencari koleksi\nlalu menyaring produk
end

db --> server: Daftar rekaman produk
deactivate db

server -> server: Penyesuaian nama cari\nbeberapa kata jika ada

server --> klien: Badan JSON daftar produk
deactivate server

alt Respons sukses dan berisi produk
  klien -> pengguna: Menampilkan kartu produk\ndan tautan detail
else Respons sukses namun daftar kosong
  klien -> pengguna: Menampilkan area tanpa item
else Respons gagal / kesalahan jaringan
  klien -> pengguna: Menampilkan pesan kesalahan jaringan
end

deactivate klien

@enduml