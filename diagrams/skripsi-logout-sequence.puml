@startuml skripsi_logout_sequence
title Sequence Diagram — Logout\nPelanggan, komponen logout-button

skinparam SequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 15
skinparam BoxPadding 15
skinparam DefaultFontSize 15
skinparam ArrowFontSize 13
skinparam ParticipantFontSize 15

actor Pelanggan as pengguna
participant "Aplikasi Butik Busana\n(Klien)" as klien
participant "Server Next.js\n(Aksi & API)" as server

pengguna -> klien: Menekan tombol Logout
activate klien

klien -> pengguna: Menampilkan dialog konfirmasi

alt Batal atau tutup dialog
  pengguna -> klien: Memilih tidak jadi logout
  klien -> pengguna: Menutup dialog tanpa mengubah sesi
else Konfirmasi keluar
  pengguna -> klien: Memilih yakin logout
  klien -> server: Memanggil signOut() (Kirim request keluar)
  activate server

  server -> server: Mengakhiri sesi & menghapus cookie sesi
  server --> klien: Jawaban penutupan selesai
  deactivate server

  klien -> klien: Memuat ulang ke halaman beranda
  klien -> pengguna: Peramban menampilkan beranda ter-logout
end

deactivate klien

@enduml