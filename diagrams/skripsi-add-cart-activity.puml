@startuml skripsi_add_cart_activity
title Activity Diagram — Tambah Produk ke Keranjang\nPelanggan, halaman detail produk

skinparam ActivityFontSize 12
skinparam TitleFontSize 14
skinparam Padding 6

|Pelanggan|
start
:Menentukan jumlah barang;
:Menekan tombol tambahkan ke keranjang;

|Client|
:Mengirim data produk dan kuantitas\nke layanan keranjang;
|Server|
:Memverifikasi bahwa sesi pengguna aktif;
if (Sesi tidak valid?) then (ya)
  :Menolak permintaan\ndengan pesan perlu masuk akun;
  |Client|
  :Menampilkan pesan kesalahan kepada pengguna;
  stop
endif
|Database|
:Mengambil isi keranjang\nyang terikat pada pengguna;
|Server|
if (Barang dan varian yang sama\nsudah ada di keranjang?) then (ya)
  :Menambah kuantitas\npada baris yang sudah ada;
else (tidak)
  :Menambah entri baris baru\nberisi rincian produk;
endif
:Menyimpan keranjang yang diperbarui;
|Client|
:Menyegarkan tampilan ikon dan daftar keranjang;
:Menampilkan notifikasi berhasil;

stop

@enduml
