@startuml skripsi_register_sequence
title Sequence Diagram — Pendaftaran\nPelanggan, halaman daftar

skinparam SequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 15
skinparam BoxPadding 15
skinparam DefaultFontSize 15
skinparam ArrowFontSize 13
skinparam ParticipantFontSize 15

actor Pelanggan as pengguna
participant "Aplikasi Butik Busana\n(Klien)" as klien
participant "Server Next.js\n(Aksi & API)" as server
database "BasisData\n(Prisma)" as db

pengguna -> klien: Mengisi nama, email, kata sandi, lalu menekan "Daftar"
activate klien

klien -> server: POST /api/auth/register (Kirim data pendaftaran)
activate server

server -> server: Memeriksa format email & panjang sandi

alt Validasi format gagal
  server --> klien: Respons galat validasi (status 400)
  klien -> pengguna: Menampilkan notifikasi galat data formulir
else Validasi format lolos
  server -> db: Query user berdasarkan email
  activate db
  db --> server: Data rekaman (ada/tidak ada)
  deactivate db

  alt Email sudah digunakan
    server --> klien: Respons email sudah terdaftar (status 400)
    klien -> pengguna: Menampilkan notifikasi email sudah digunakan
  else Email tersedia
    server -> db: Query peran default pelanggan
    activate db
    db --> server: Data peran pelanggan
    deactivate db

    server -> server: Meng-hash kata sandi

    server -> db: Menyimpan pengguna baru ke database
    activate db
    db --> server: Konfirmasi penyimpanan sukses
    deactivate db

    server --> klien: Respons profil ringkas sukses
    deactivate server

    klien -> pengguna: Menampilkan notifikasi berhasil daftar
    klien -> klien: Navigasi ke halaman login
  end
end

deactivate klien

@enduml