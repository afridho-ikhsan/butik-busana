@startuml skripsi_proses_pembayaran_activity
title Activity Diagram — Proses Pembayaran (VA, QRIS, E-Wallet)\nModul Transaksi, CartModal + Midtrans

skinparam ActivityFontSize 12
skinparam TitleFontSize 14

|Pelanggan|
start
:Mengisi form pemesanan\ndan menekan Lanjut Pembayaran;

|Client|
if (Validasi form lolos?) then (tidak)
  :Menampilkan pesan error\npada field yang tidak valid;
  stop
else (ya)
endif
:Menampilkan dialog konfirmasi\nApakah data pemesanan sudah benar?;

|Pelanggan|
:Menekan tombol Sudah;

|Client|
:Memanggil server action createOrder\ndengan data checkout dari form;

|Server|
:Memproses data pesanan;

|BasisData|
:Menyimpan pesanan baru\nstatus APPROVED paymentStatus NOT_PAID;

|Server|
:Mengembalikan orderId\ndan orderNumber ke client;

|Client|
:Memanggil orderTokenizer\ndengan orderId pesanan yang baru dibuat;

|Midtrans Snap|
:Membuat token transaksi Snap\nberdasarkan orderId dan nominal;
:Membuka popup Snap pay\nVA QRIS e-wallet;

|Pelanggan|
if (Menyelesaikan pembayaran?) then (tidak)
  :Menutup popup Snap;
  |Client|
  :Mengalihkan ke halaman daftar transaksi\npesanan tertunda dapat dibayar nanti;
  stop
else (ya)
  :Memilih metode dan menyelesaikan\npembayaran pada antarmuka Midtrans;
endif

|Midtrans Gateway|
:Mengirim notifikasi webhook POST\nke /api/midtrans-notification;

|Server|
if (transaction_status settlement atau capture?) then (ya)
  |BasisData|
  :Memperbarui status pesanan\nmenjadi APPROVED dan PAID;
  :Menyimpan atau memperbarui\nbukti invoice Midtrans;
elseif (deny cancel expire failure?) then (ya)
  |Server|
  :Menolak pembayaran;
else (status lain)
  stop
endif

|Client|
:Mengalihkan ke halaman daftar transaksi\nonSuccess Snap;

stop

@enduml
