@startuml skripsi_terima_notifikasi_deadline_pembayaran_sequence
title Sequence Diagram — Terima Notifikasi Pengingat Deadline Pembayaran\nModul Notifikasi PWA, GET /api/cron/payment-deadline-reminder

skinparam SequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 15
skinparam BoxPadding 15
skinparam DefaultFontSize 15
skinparam ArrowFontSize 13
skinparam ParticipantFontSize 15

actor "Sistem Cron\ncron-job.org" as cron
actor Pelanggan as pengguna
participant "Server Next.js\n(Aksi & API)" as server
database "BasisData\n(Prisma)" as db
participant "Aplikasi Butik Busana\n(Klien)" as klien

cron -> server: GET /api/cron/payment-deadline-reminder\nAuthorization Bearer CRON_SECRET
activate server

alt Token tidak valid
  server --> cron: 401 Unauthorized
else Token valid
  server -> server: reminderMinutes dari env\ndefault 30 15 5

  loop Untuk setiap ambang menit pengingat
    server -> server: Hitung rentang waktu pembuatan pesanan

    server -> db: findMany NOT_PAID\nyang belum pernah dikirim notifikasi di ambang ini
    activate db
    db --> server: Daftar pesanan cocok
    deactivate db

    loop Untuk setiap pesanan
      server -> db: count PushSubscription userId
      activate db
      db --> server: subscriptionCount
      deactivate db

      alt subscriptionCount > 0 (Ada langganan push)
        server -> db: findFirst PushSubscription
        activate db
        db --> server: Endpoint & keys langganan
        deactivate db

        server -> server: webPush.sendNotification (Kirim ke Push Service)
        server -> klien: Kirim payload notifikasi
        activate klien

        klien -> pengguna: Tampilkan notifikasi "Pembayaran X menit lagi habis"

        server -> db: update paymentDeadlineReminderSentAt
        activate db
        db --> server: Tanda pengingat tersimpan
        deactivate db

        opt Pelanggan mengetuk notifikasi
          pengguna -> klien: Ketuk notifikasi
          klien -> pengguna: Buka & arahkan ke halaman detail transaksi
        end
        deactivate klien
      end
    end
  end

  server --> cron: JSON status pengiriman
  deactivate server
end

@enduml