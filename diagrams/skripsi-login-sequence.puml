@startuml skripsi_login_sequence
title Sequence Diagram — Login\nPelanggan, halaman login

skinparam SequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 15
skinparam BoxPadding 15
skinparam DefaultFontSize 15
skinparam ArrowFontSize 13
skinparam ParticipantFontSize 15

actor Pelanggan as pengguna
participant "Aplikasi Butik Busana\n(Klien)" as klien
participant "Server Next.js\n(Aksi & API)" as server
database "BasisData\n(Prisma)" as db

pengguna -> klien: Mengisi email & kata sandi, lalu menekan "Masuk"
activate klien

klien -> server: signIn("credentials", { email, password }) (Kirim kredensial)
activate server

server -> db: Query user berdasarkan email
activate db
db --> server: Data pengguna (email, password hash)
deactivate db

server -> server: Memverifikasi password hash

alt Kredensial tidak cocok (salah)
  server --> klien: Galat otentikasi (error)
  klien -> pengguna: Menampilkan notifikasi email/password salah
else Kredensial cocok (sukses)
  server -> server: Membuat sesi pengguna & cookie sesi
  server --> klien: Hasil login sukses (ok)
  deactivate server

  klien -> pengguna: Menampilkan notifikasi login berhasil
  klien -> klien: Navigasi ke halaman tujuan / beranda
end

deactivate klien

@enduml