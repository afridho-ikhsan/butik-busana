@startuml skripsi_hapus_keranjang_sequence
title Sequence Diagram — Hapus Produk dari Keranjang\nPelanggan, tampilan keranjang

skinparam SequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 15
skinparam BoxPadding 15
skinparam DefaultFontSize 15
skinparam ArrowFontSize 13
skinparam ParticipantFontSize 15

actor Pelanggan as pengguna
participant "Aplikasi Butik Busana\n(Klien)" as klien
participant "Server Next.js\n(Aksi & API)" as server
database "BasisData\n(Prisma)" as db

pengguna -> klien: Menekan hapus pada baris produk
activate klien

klien -> klien: Mengambil pengenal baris (itemId)

klien -> server: DELETE /api/cart?itemId=... (Kirim request hapus)
activate server

server -> server: Memeriksa sesi pengguna aktif

alt Sesi tidak sah atau kosong
  server --> klien: Respons perlu login
  klien -> pengguna: Tampilkan pesan galat dari server
else Sesi sah
  server -> db: Membaca keranjang milik pengguna
  activate db
  db --> server: Daftar baris keranjang
  deactivate db

  server -> server: Menyaring baris & menghapus baris terpilih

  server -> db: Menyimpan keranjang terbaru tanpa baris itu
  activate db
  db --> server: Tersimpan
  deactivate db

  server --> klien: Keranjang terbaru & subtotal
  deactivate server

  klien -> klien: Menyegarkan tampilan daftar keranjang
  klien -> pengguna: Daftar keranjang diperbarui di layar
end

deactivate klien

@enduml